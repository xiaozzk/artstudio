# --- Logs / temp -----------------------------------------------------------
*.log
*.tmp
*.bak
*.pid
*.seed
*.pid.lock
.cache/

# --- Local artifacts -------------------------------------------------------
test-output/
out/
tmp/
# download/ 是"刚下载、还没处理"的落地目录（素材包 / 第三方仓库 / 待转换资源…）。
# 与 tmp/ 的区别：tmp/ 放**可再生的中间产物**，download/ 放**还没决定去留的原始下载**；
# 两者都不入库，但 download/ 里的东西通常比 tmp/ 更值得留（别随手清）。
download/

# --- 外部仓库 / 外部资料（本地参考，不入库）--------------------------------
# docs/spine-animation-ai/ 是**自带 .git 的独立仓库**（clone 来的参考资料）：直接 add 只会记成
# 没有 .gitmodules 的"幽灵子模块"，别人 clone 下来是个空目录 —— 所以本地留着、不入库。
# 要正式纳入就改成 submodule（写 .gitmodules + remote）。
docs/spine-animation-ai/

# --- Agent / CLI 工具产物（本机配置 + 中间产物，不入库）---------------------
# .claude/ 是本机 AI 编码工具的本地设置（settings.local.json 等）。原先只靠本机全局
# ~/.config/git/ignore 忽略 —— clone 到别的机器就不再生效，故写进仓库规则。
# 中间产物（提交信息草稿 / 报告 / 预览图 / 浏览器 profile 副本…）一律写 tmp/（已忽略）。
.claude/

# --- meowa/ 生图工作区（静态素材走 Git LFS 托管，见 .gitattributes）---------
# 只排除可再生的批量产物；其余素材 / 参考图 / 存档全部入库（由 LFS 存大文件）
meowa/runs/
meowa/qa/

# --- 2D 归档（7z 包，本地保留，不入库）-------------------------------------
# 原 reference/ 已打包为 archive-2d/reference-2d.7z（40173 文件 / 3277 目录 / 约 640 MiB）
# 大二进制不入库；需要时本地解压，或按原方式稀疏重新拉取
archive-2d/

# --- Blender 自动备份（.blend1/.blend2… 是上一次的保存副本，不入库）-----------
*.blend[0-9]*